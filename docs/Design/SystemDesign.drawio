        <mxCell id="8wdyk8E4qUwrByH0UspS-126" value="&lt;font color=&quot;#99ccff&quot;&gt;Redis will help in term of cache 4x the amount of data, cursor, so it minimise the round tip to sql db&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="IdTssMJ4M_bueztje77A-70" vertex="1">
