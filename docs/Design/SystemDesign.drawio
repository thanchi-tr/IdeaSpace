        <mxCell id="8wdyk8E4qUwrByH0UspS-91" value="&lt;font color=&quot;#99ccff&quot;&gt;The Group Strategy allow user fast and efficiently hover between different view&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="IdTssMJ4M_bueztje77A-70" vertex="1">
